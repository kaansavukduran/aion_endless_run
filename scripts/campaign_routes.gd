static func draw_pump(v) -> void:
	if PUMP_X+48.<v.camera_x or PUMP_X-48.>v.camera_x+v.scene_w:return
	var w=v.world
	var animated: bool=v.host.motion_enabled and not v.host.options.reduced_motion
	CampaignForgePropArt.draw(v,"water_pump",v.at(Vector2(PUMP_X,LOWER_FLOOR)),pump_frame(w,animated))
	if animated and w.notice=="arc_route_pump_open" and w.notice_time>NOTICE_SECONDS-.8:
		var progress:=clampf((NOTICE_SECONDS-float(w.notice_time))/.8,0.,1.)
		var edge: Vector2=v.at(Vector2(DRY_START+2.,LOWER_FLOOR))
		for i in 4:
			var drop:=Vector2(4.+i*6.,-7.+float(i%2)*4.+progress*60.)
			v.draw_rect(Rect2((edge+drop).round(),Vector2(3.,9.+i*2.)),Color("a4e0d3",1.-progress))

static func pump_frame(w,animated: bool) -> int:
	if pump_open(w):return 2+posmod(floori(w.time*5.),2) if animated else 2
	return int(w.activated.has(PUMP_PART_ID))

static func draw_crow_deflections(v) -> void:
	var animated: bool=v.host.motion_enabled and not v.host.options.reduced_motion
	for crow: Dictionary in v.world.enemies:
		if crow.kind!="crow" or bool(crow.defeated) or not crow.has("roof_deflection"):continue
		var age:=float(crow.age)-float(crow.roof_deflection_age)
		if age>=ROOF_DEFLECTION_SECONDS:continue
		var point: Vector2=v.at(crow.roof_deflection)
		if point.x< -28. or point.x>v.scene_w+28.:continue
		var progression:=age/ROOF_DEFLECTION_SECONDS if animated else .35
		var offset:=Vector2(4.+progression*18.,7.+progression*17.)
		for side in [-1.,1.]:
			var spark: Vector2=(point+Vector2(side*offset.x,-offset.y)).round()
			v.draw_rect(Rect2(spark-Vector2(3.,2.),Vector2(8.,4.)),Color("6c4637",1.-progression))
			v.draw_rect(Rect2(spark-Vector2(1.,1.),Vector2(4.,2.)),Color("ffe2a1",1.-progression))
		v.draw_rect(Rect2(point-Vector2(7.,3.),Vector2(14.,3.)),Color("f5c486",1.-progression))

static func draw_route_sign(v,position: Vector2,vertical: float) -> void:
	if position.x+16.<v.camera_x or position.x-16.>v.camera_x+v.scene_w:return
	var p: Vector2=v.at(position).round()
	var wood:=Color("70523f")
	var ink:=Color("f3d590") if vertical==0. else Color("a2d3cc")
	v.draw_rect(Rect2(p+Vector2(-3,-41),Vector2(6,41)),Color("433945"))
	v.draw_rect(Rect2(p+Vector2(-1,-38),Vector2(2,37)),wood)
	v.draw_rect(Rect2(p+Vector2(-16,-49),Vector2(32,18)),Color("322c36"))
	v.draw_rect(Rect2(p+Vector2(-14,-47),Vector2(28,14)),wood)
	v.draw_rect(Rect2(p+Vector2(-13,-46),Vector2(26,1)),Color("b18c61"))
	var end: Vector2=p+Vector2(8,-40+vertical*4.)
	v.draw_line(p+Vector2(-8,-40-vertical*4.),end,ink,2.)
	v.draw_line(end-Vector2(5,1.+vertical*5.),end,ink,2.)
	v.draw_line(end-Vector2(5,-4.+vertical*5.),end,ink,2.)

static func draw_junction_board(v) -> void:
	const LEFT := 233.
	const WIDTH := 400.
	const ROW_HEIGHT := 33.
	const TOP_ABOVE_DECK := 222.
	if LEFT+WIDTH<v.camera_x or LEFT>v.camera_x+v.scene_w:return
	var p: Vector2=v.at(Vector2(LEFT,WALKWAYS[0].position.y-TOP_ABOVE_DECK)).round()
	var post_top:=ROW_HEIGHT*3.-3.
	var post_height:=TOP_ABOVE_DECK-post_top
	for x in [64.,264.]:
		v.draw_rect(Rect2(p+Vector2(x,post_top),Vector2(9.,post_height)),Color("494044"))
		v.draw_rect(Rect2(p+Vector2(x+2.,post_top+1.),Vector2(2.,post_height-2.)),Color("a68160"))
	var labels := ["fork_reward_upper","fork_reward_middle","fork_reward_lower"]
	var arrows := [Vector2.UP,Vector2.RIGHT,Vector2.DOWN]
	var colors := [Color("f2cf86"),Color("e5a777"),Color("a5dfd3")]
	v.draw_rect(Rect2(p-Vector2(2,2),Vector2(WIDTH+4.,ROW_HEIGHT*3.+4.)),Color("342c35"))
	for i in labels.size():
		var row: Vector2=p+Vector2(0.,i*ROW_HEIGHT)
		v.draw_rect(Rect2(row,Vector2(WIDTH,ROW_HEIGHT-1.)),Color("765844"))
		v.draw_rect(Rect2(row+Vector2(2,2),Vector2(WIDTH-4.,ROW_HEIGHT-5.)),Color("352f39"))
		var direction: Vector2=arrows[i]
		var tip: Vector2=row+Vector2(18,16)+direction*7.
		var corner: Vector2=direction.orthogonal()*5.
		v.draw_line(tip-direction*14.,tip,colors[i],2.)
		v.draw_line(tip-direction*5.+corner,tip,colors[i],2.)
		v.draw_line(tip-direction*5.-corner,tip,colors[i],2.)
		v.caption(CampaignFieldUI.text(v.host,labels[i]),row+Vector2(39,23),23)

static func draw_cage_latches(v) -> void:
	var w=v.world
	for o in w.objects:
		if str(o.kind)!="cage" or not bool(o.active) or float(o.x)<v.camera_x-70. or float(o.x)>v.camera_x+v.scene_w+70.:continue
		var id: String=str(o.id)
		var armed: bool=w.activated.has(id+":trap-set")
		if not armed and (absf(float(o.x)-w.player.x)>62. or nearby_open_cage(w)!=o):continue
		var p: Vector2=v.at(Vector2(float(o.x),float(o.y)))
		var spent: bool=w.activated.has(id+":trap-spent")
		if spent:
			for x in range(-25,27,8):v.draw_rect(Rect2(p+Vector2(x,-62),Vector2(2,58)),Color("806440"))
			v.draw_rect(Rect2(p+Vector2(-29,-40),Vector2(58,3)),Color("c49962"))
		var lamp:=Color("8f736c") if spent else (Color("b8e1ac") if armed else Color("f0c478"))
		v.draw_rect(Rect2(p+Vector2(19,-46),Vector2(12,12)),Color("3c3038"))
		v.draw_rect(Rect2(p+Vector2(21,-44),Vector2(8,8)),Color("b59061"))
		v.draw_rect(Rect2(p+Vector2(23,-42),Vector2(4,5)),lamp)

static func draw_cage_front(v) -> void:
	if v.world.section!="fork_one":return
	for cage in v.world.objects:
		if cage.id!=TECHNICIAN_CAGE_ID or bool(cage.active):continue
		if float(cage.x)+70.<v.camera_x or float(cage.x)-70.>v.camera_x+v.scene_w:return
		var p: Vector2=v.at(Vector2(float(cage.x),float(cage.y)))
		# Foreground ribs leave enough open space to read her face and rope.
		var roof:=PackedVector2Array([Vector2(-62,-88),Vector2(-62,-101),Vector2(-49,-112),Vector2(-26,-122),Vector2(25,-122),Vector2(49,-112),Vector2(62,-101),Vector2(62,-88)])
		for i in roof.size():roof[i]+=p
		v.draw_polyline(roof,Color("3f2e29"),6.)
		for i in roof.size():roof[i].y-=1.
		v.draw_polyline(roof,Color("b88c56"),2.)
		for x in [-62.,-42.,-20.,4.,26.,46.,59.]:
			var top: float=-119.+floorf(absf(x)*.005*absf(x))
			v.draw_rect(Rect2(p+Vector2(x,top),Vector2(4,-top-5.)),Color("634930"))
			v.draw_rect(Rect2(p+Vector2(x+1.,top),Vector2(1,-top-6.)),Color("c2935b"))
		v.draw_rect(Rect2(p+Vector2(-66,-10),Vector2(132,10)),Color("473c36"))
		v.draw_rect(Rect2(p+Vector2(-65,-11),Vector2(130,4)),Color("b09363"))
		v.draw_rect(Rect2(p+Vector2(-61,-38),Vector2(122,3)),Color("85613d"))
		v.draw_rect(Rect2(p+Vector2(44,-49),Vector2(20,15)),Color("4d392d"))
		v.draw_rect(Rect2(p+Vector2(47,-47),Vector2(14,11)),Color("a47a45"))
		v.draw_rect(Rect2(p+Vector2(52,-45),Vector2(4,6)),Color("f8cb7c"))
		return

static func draw_landmarks(v) -> void:
	draw_cage_latches(v)
	if SHELTERS.has(v.world.section):draw_crow_deflections(v)
	if not is_fork(str(v.world.section)):return
	for p in lantern_positions(v.world):
		v.draw_pose(v.catalogue.pose("environment",2,3),p)
	for p in exit_flag_positions(v.world):
		v.draw_flag(p,.84)
	if v.world.section=="fork_one":
		draw_junction_board(v)
		draw_route_sign(v,Vector2(532.,0.),-1.)
		draw_route_sign(v,Vector2(619.,0.),1.)
		draw_route_sign(v,Vector2(1286.,MIDDLE_WALKWAYS[0].position.y),-1.)
		draw_route_sign(v,Vector2(1440.,MIDDLE_FLOOR),0.)
		draw_pump(v)
