class_name CampaignRoutes
extends RefCounted

## Physical junctions: no choice state or dialog owns route selection.
## Each junction uses a different physical idea, read from the world itself:
## - fork_one (shore): a low crawlway passes under the solid pier house.
##   Beyond it, a stair reaches the middle causeway flag. The lower flag is
##   reached along the wet floor or through a drained service tunnel.
##   The raised roof and upper deck are reached from the entry walkways.
## - fork_two (canopy): the lower root channel is closed by a root-locked hatch.
##   Breaking its lock mechanism opens the floor. The upper service path has a
##   failing middle span that collapses a few seconds after it is stepped on.
## Rules live here; the view only draws these same rectangles (art-replaceable).
const FORKS := ["fork_one","fork_two"]
const DROP_X := 650.
const LOWER_FLOOR := 90.
const UPPER_FLOOR := -195.
const EXIT_X := 1480.
const WALKWAYS := [Rect2(280.,-65.,240.,20.),Rect2(510.,-130.,260.,20.),Rect2(740.,UPPER_FLOOR,1040.,22.)]
const MIDDLE_FLOOR := 0.
const MIDDLE_WALKWAYS := [Rect2(1214.,44.,130.,16.),Rect2(1370.,MIDDLE_FLOOR,390.,20.)]
const DRY_START := 1410.
const DRY_FLOOR := 162.
const DRY_EXIT_X := 1700.
const DRY_CACHE_DECK := Rect2(1520.,104.,132.,16.)
const PUMP_X := 1360.
const PUMP_ID := "fork_one:pump"
const TECHNICIAN_ID := "fork_one:technician"
const TECHNICIAN_CAGE_ID := "fork_one:technician:cage"
const PUMP_PART_ID := "fork_one:technician:relay_part"
const DRY_SUPPLY_ID := "fork_one:pump:service-supply"
const DRY_CACHE_ID := "fork_one:pump:maintenance-cache"
const UPPER_SUPPLY := [
	{"id":"fork_one:upper:ammo","x":930.,"y":UPPER_FLOOR-32.,"kind":"pistol_ammo"},
	{"id":"fork_one:upper:grenades","x":1280.,"y":UPPER_FLOOR-32.,"kind":"grenade"},
]
const CAUSEWAY_PATROL := "causeway_relay_approach"
const CAUSEWAY_REWARD_ID := "causeway:patrol-bonus"
const CAUSEWAY_BONUS := 450
const ROOF_DEFLECTION_SECONDS := .30
const NOTICE_SECONDS := 2.8
const SHELTERS := {
	"shore":[Rect2(1010.,-106.,138.,18.),Rect2(2960.,-68.,180.,18.)],
	"canopy":[Rect2(1030.,-99.,180.,18.)]
}
# fork_one pier house: solid from its roof (the upper deck) down to the crawl ceiling.
const PIER := Rect2(780.,UPPER_FLOOR,400.,230.)
const CRAWL_CEILING := 35.
const STAND_HEIGHT := 74.
const CROUCH_HEIGHT := 40.
const MOUNTED_HEIGHT := 132.
const BODY_HALF_WIDTH := 16.
# fork_two: a different stair rhythm; the middle span is a failing service bridge.
const SERVICE_WALKWAYS := [Rect2(360.,-80.,150.,20.),Rect2(540.,-140.,200.,18.),Rect2(720.,UPPER_FLOOR,1060.,22.)]
const SERVICE_BRIDGE_X := 540.
const SERVICE_BRIDGE_SECONDS := 2.4
const SERVICE_SUPPORT := Rect2(538.,-98.,69.,20.)
const HATCH_ID := "fork_two:root_lock"
const HATCH_LOCK_X := 820.
const HATCH_X := 900.
const YARD_END_X := 1400.

static func is_fork(section: String) -> bool:
	return section in FORKS

static func hatch_open(w) -> bool:
	return w.activated.has(HATCH_ID)

static func pump_open(w) -> bool:
	return w.activated.has(PUMP_ID)

static func pickup_exposed(w,item: Dictionary) -> bool:
	if str(item.id) in [DRY_SUPPLY_ID,DRY_CACHE_ID]:return pump_open(w)
	return w.section!="fork_two" or hatch_open(w) or float(item.y)<=floor_height(w,float(item.x))

static func lower_start(w) -> float:
	return HATCH_X if str(w.section)=="fork_two" else DROP_X

## y is the actor's support query height; the default asks for the lowest floor.
static func floor_height(w,x: float,y: float=1e9) -> float:
	if str(w.section)=="fork_two":
		return LOWER_FLOOR if hatch_open(w) and x>=HATCH_X else 0.
	if x<DROP_X:return 0.
	# The pier house roof is solid: nothing above it falls into the crawlway.
	if x>=PIER.position.x and x<=PIER.end.x and y<=CRAWL_CEILING:return UPPER_FLOOR
	return DRY_FLOOR if x>=DRY_START and pump_open(w) else LOWER_FLOOR

static func populate(w) -> void:
	# Clear the procedural corridor generated by older checkpoints. Everything
	# below is real geometry/loot; no invisible 'choose high/low' trigger at entry.
	w.enemies.clear();w.gates.clear();w.pits.clear();w.platforms.clear()
	w.pickups.clear();w.crates.clear();w.npcs.clear();w.objects.clear()
	w.zones.clear();w.rooms.clear();w.hazards.clear();w.encounters.clear()
	var second: bool=w.section=="fork_two"
	for surface in (SERVICE_WALKWAYS if second else WALKWAYS):w.platforms.append(surface)
	# The upper sentry holds the deck; the lower one waits beyond the crawlway
	# or hatch so the first safe floor after the passage is visible and free.
	w.spawn_enemy("mirror" if second else "seed",1230.,UPPER_FLOOR,w.enemies.size())
	w.spawn_enemy("conductor" if second else "seed",1380.,LOWER_FLOOR,w.enemies.size())
	if second:
		w.objects.append({"id":HATCH_ID,"kind":"relay","x":HATCH_LOCK_X,"y":0.,"hp":4,"active":hatch_open(w),"secret":""})
	var upper := [Vector2(400.,-115.),Vector2(470.,-115.),Vector2(600.,-175.),Vector2(700.,-175.)] if second else [Vector2(330.,-100.),Vector2(450.,-100.),Vector2(560.,-165.),Vector2(680.,-165.)]
	upper+=[Vector2(860.,-230.),Vector2(1000.,-230.),Vector2(1180.,-230.),Vector2(1380.,-230.)]
	# Lower loot marks the passage itself: a lit line through the crawlway, or
	# the root channel beneath the hatch once it opens.
	var lower := [Vector2(1000.,55.),Vector2(1120.,55.),Vector2(1260.,55.)] if second else [Vector2(860.,62.),Vector2(980.,62.),Vector2(1100.,62.)]
	var positions: Array=upper+lower
	for i in positions.size():
		var id: String=w.section+":route-fruit:"+str(i)
		if not w.taken.has(id):w.pickups.append({"id":id,"x":positions[i].x,"y":positions[i].y,"kind":"fruit_"+str(i%8)})
	# The harder lower passage pays out a usable supply where it ends.
	var supply: String=w.section+":passage-supply"
	if not w.taken.has(supply):
		w.pickups.append({"id":supply,"x":1300. if second else 1240.,"y":55.,"kind":"heal" if second else "grenade"})
	if not second:install_first_fork(w)

static func install_first_fork(w) -> void:
	for deck in MIDDLE_WALKWAYS:
		if deck not in w.platforms:w.platforms.append(deck)
	for supply in UPPER_SUPPLY:install_pickup(w,supply)
	if pump_open(w):install_dry_alcove(w)
	var freed: bool=w.rescued.has(TECHNICIAN_ID)
	var shown_gift: bool=w.gift_drops.has(TECHNICIAN_ID)
	var claimed: bool=w.taken.has(TECHNICIAN_ID+":supply") or w.awarded.has(TECHNICIAN_ID+":gift")
	if not w.objects.any(func(o):return str(o.id)==TECHNICIAN_CAGE_ID):
		w.objects.append({"id":TECHNICIAN_CAGE_ID,"kind":"cage","x":1250.,"y":LOWER_FLOOR,
			"hp":1,"active":freed or w.activated.has(TECHNICIAN_CAGE_ID),"secret":""})
	if not w.npcs.any(func(n):return str(n.id)==TECHNICIAN_ID):
		var phase: String="bound"
		if freed:phase="departed" if claimed or shown_gift else ("thanks" if w.greeted.has(TECHNICIAN_ID) else "free")
		var npc: Dictionary={"id":TECHNICIAN_ID,"x":1250.,"home_x":1250.,"y":LOWER_FLOOR,"freed":freed,
			"variant":2,"role":"technician","gift":"relay_part","phase":phase,"roam_clock":0.,"facing":-1,
			"free_age":99. if shown_gift or claimed else 0.,"thank_age":99. if shown_gift or claimed else 0.,
			"secret":"","cage":TECHNICIAN_CAGE_ID}
		npc.clip=CampaignRescue.clip_name(npc)
		w.npcs.append(npc)
	if shown_gift and not claimed and not w.pickups.any(func(item):return str(item.id)==TECHNICIAN_ID+":supply"):
		var drop: Dictionary=Dictionary(w.gift_drops[TECHNICIAN_ID]).duplicate(true)
		drop.age=0.
		w.pickups.append(drop)

static func install_pickup(w, item: Dictionary) -> void:
	if not w.taken.has(item.id) and not w.pickups.any(func(existing):return existing.id==item.id):
		w.pickups.append(item.duplicate())

static func install_dry_alcove(w) -> void:
	if DRY_CACHE_DECK not in w.platforms:w.platforms.append(DRY_CACHE_DECK)
	install_pickup(w,{"id":DRY_SUPPLY_ID,"x":1455.,"y":DRY_FLOOR-31.,"kind":"pistol_ammo"})
	install_pickup(w,{"id":DRY_CACHE_ID,"x":1588.,"y":DRY_CACHE_DECK.position.y-30.,"kind":"points"})

static func reward_causeway_patrol(w, defeated_id: String) -> void:
	if w.section!="causeway" or w.awarded.has(CAUSEWAY_REWARD_ID):return
	for encounter in w.encounters:
		if encounter.role!=CAUSEWAY_PATROL or defeated_id not in encounter.enemies:continue
		if encounter.enemies.all(func(id):return w.awarded.has(id)):
			w.award(CAUSEWAY_REWARD_ID,CAUSEWAY_BONUS)
			w.pending_events.append("mechanism")
			notify(w,"arc_route_patrol_clear")
		return

static func install_shelters(w) -> void:
	for deck in SHELTERS.get(w.section,[]):
		if deck not in w.platforms:w.platforms.append(deck)

static func clear_open_route_locks(w) -> void:
	if w.section not in ["quay","causeway"]:return
	w.gates.clear()
	w.objects.assign(w.objects.filter(func(o):return o.kind!="gate"))

static func after_restore(w) -> void:
	# Exact older snapshots replace authored arrays after loading the section.
	# Add only new stable records, retaining visited paths and claimed pickups.
	if w.section=="fork_one":install_first_fork(w)
	clear_open_route_locks(w)
	install_shelters(w)

static func is_shelter(section: String,deck: Rect2) -> bool:
	return deck in SHELTERS.get(section,[])

static func crow_sheltered(w,contact: Vector2) -> bool:
	for roof: Rect2 in SHELTERS.get(w.section,[]):
		if contact.x>roof.position.x+10. and contact.x<roof.end.x-10. and contact.y-74.>=roof.end.y-1.:
			if not w.disabled_platforms.has(roof.position.x):return true
	return false

static func crow_roof_hit(w,from: Vector2,to: Vector2) -> bool:
	return crow_roof_contact(w,from,to).is_finite()

static func crow_roof_contact(w,from: Vector2,to: Vector2) -> Vector2:
	if to.y<=from.y:return Vector2.INF
	for roof: Rect2 in SHELTERS.get(w.section,[]):
		var top:=roof.position.y-14.
		if from.y>top or to.y<top:continue
		var hit_x:=lerpf(from.x,to.x,inverse_lerp(from.y,to.y,top))
		if hit_x>=roof.position.x and hit_x<=roof.end.x and not w.disabled_platforms.has(roof.position.x):
			return Vector2(hit_x,roof.position.y)
	return Vector2.INF

static func stop_crow_dive_at_roof(w,enemy: Dictionary,to: Vector2) -> bool:
	var contact:=crow_roof_contact(w,Vector2(enemy.get("dive_last",enemy.dive_start)),to)
	if not contact.is_finite():return false
	enemy.roof_deflection=contact
	enemy.roof_deflection_age=float(enemy.age)
	return true

static func nearby_open_cage(w) -> Dictionary:
	for o in w.objects:
		if str(o.kind)!="cage" or not bool(o.active):continue
		if absf(float(o.x)-w.player.x)>62. or absf(float(o.y)-w.player.y)>28.:continue
		var id: String=str(o.id)
		if w.activated.has(id+":trap-set") or w.activated.has(id+":trap-spent"):continue
		if w.npcs.any(func(n):return str(n.get("cage",""))==id and not bool(n.freed)):continue
		return o
	return {}

static func context_action(w) -> String:
	if w.state!="playing" or bool(w.mount.ridden) or not w.grounded():return ""
	if w.section=="fork_one" and not pump_open(w) and absf(w.player.x-PUMP_X)<50. and absf(w.player.y-LOWER_FLOOR)<28.:
		return "arc_run_pump" if w.activated.has(PUMP_PART_ID) else "arc_inspect_pump"
	return "arc_arm_cage" if not nearby_open_cage(w).is_empty() else ""

static func notify(w,message: String) -> void:
	w.notice=message
	w.notice_time=NOTICE_SECONDS

static func use_context(w) -> bool:
	match context_action(w):
		"arc_run_pump":
			w.activated[PUMP_ID]=true
			install_dry_alcove(w)
			w.pending_events.append("mechanism")
			notify(w,"arc_route_pump_open")
			return true
		"arc_inspect_pump":
			notify(w,"arc_route_pump_hint")
			return true
		"arc_arm_cage":
			var cage:=nearby_open_cage(w)
			w.activated[str(cage.id)+":trap-set"]=true
			w.pending_events.append("mechanism")
			notify(w,"arc_route_cage_armed")
			return true
	return false

static func collect_item(w,item: Dictionary) -> bool:
	if str(item.kind)!="relay_part":return false
	w.activated[PUMP_PART_ID]=true
	w.pending_events.append("mechanism")
	notify(w,"arc_route_part_found")
	return true

static func step_cage(w,o: Dictionary) -> void:
	var id: String=str(o.id)
	if not w.activated.has(id+":trap-set") or w.activated.has(id+":trap-spent"):return
	for e in w.enemies:
		if bool(e.defeated) or bool(e.mini) or bool(e.get("heavy",false)) or CampaignEnemies.hidden(e) or CampaignContent.flying(str(e.kind)):continue
		if absf(float(e.x)-float(o.x))>42. or absf(float(e.y)-float(o.y))>39.:continue
		w.activated[id+":trap-spent"]=true
		e.x=o.x
		e.y=o.y
		e.armour=0
		w.damage_enemy(e,int(e.hp),"cage")
		w.pending_events.append("mechanism")
		notify(w,"arc_route_cage_caught")
		return

static func foot(w) -> Vector2:
	var offset:=0.
	if bool(w.mount.ridden):offset=42.-(24. if float(w.mount.get("dive",0.))>0. else 0.)
	return Vector2(w.player)+Vector2(0,offset)

## True while the hero is inside the fork_one crawlway under its real ceiling.
static func low_ceiling(w,at_x: float=INF) -> bool:
	if str(w.section)!="fork_one" or bool(w.mount.ridden):return false
	var contact: Vector2=foot(w)
	if is_finite(at_x):contact.x=at_x
	return contact.y>CRAWL_CEILING and contact.x>=PIER.position.x-BODY_HALF_WIDTH+2. and contact.x<=PIER.end.x+BODY_HALF_WIDTH-2.

static func body_height(w,at_x: float=INF) -> float:
	if bool(w.mount.ridden):return MOUNTED_HEIGHT
	var crouched: bool=w.grounded() and (w.move_axis.y>.55 or low_ceiling(w,at_x))
	return CROUCH_HEIGHT if crouched else STAND_HEIGHT

static func clamp_horizontal(w,from_x: float,to_x: float) -> float:
	if not is_fork(str(w.section)):return to_x
	var contact: Vector2=foot(w)
	# A visible lower ledge is solid from below. Walking back into it cannot use
	# the generic landing snap to teleport onto its upper floor.
	var ledge: float=lower_start(w)
	if (str(w.section)=="fork_one" or hatch_open(w)) and from_x>=ledge and to_x<ledge and contact.y>1.:return ledge
	if str(w.section)=="fork_one":
		if pump_open(w) and from_x>=DRY_START and to_x<DRY_START and contact.y>LOWER_FLOOR+.5:return DRY_START
		# The pier house is a wall for any body taller than the crawl clearance.
		# Posture is judged where the move starts; the new x is not yet reached.
		var top: float=contact.y-body_height(w,from_x)
		if top<CRAWL_CEILING and contact.y>UPPER_FLOOR+.5:
			var left: float=PIER.position.x-BODY_HALF_WIDTH
			var right: float=PIER.end.x+BODY_HALF_WIDTH
			if from_x<=left and to_x>left:return left
			if from_x>=right and to_x<right:return right
	elif not hatch_open(w) and contact.y>UPPER_FLOOR+40. and to_x>YARD_END_X:
		# The closed hatch yard ends at a tall fence below the upper deck.
		return YARD_END_X
	return to_x

static func blocked_entry(w) -> bool:
	# A standing hero pressing into the crawl mouth: show the posture hint once.
	if str(w.section)!="fork_one" or bool(w.mount.ridden) or low_ceiling(w):return false
	var contact: Vector2=foot(w)
	return contact.y>CRAWL_CEILING and absf(contact.x-(PIER.position.x-BODY_HALF_WIDTH))<1. and w.move_axis.x>.3

static func solid_at(w,p: Vector2) -> bool:
	return str(w.section)=="fork_one" and PIER.has_point(p)

static func camera_y(w,default_y: float) -> float:
	if not is_fork(str(w.section)):return default_y
	var contact: Vector2=foot(w)
	# Look up with a climber and follow a true descent. A glimpse of the next
	# landing starts near the lip, in the same coordinate space as the hero.
	if contact.y<-58.:return minf(default_y,contact.y+58.)
	if w.section=="fork_one" and contact.y>=0.:
		if contact.x>=580. and contact.x<DROP_X:
			return maxf(contact.y,28.*smoothstep(580.,DROP_X,contact.x))
		if pump_open(w) and contact.y>=LOWER_FLOOR-.5 and contact.x>=DRY_START-70. and contact.x<DRY_START:
			return maxf(contact.y,LOWER_FLOOR+28.*smoothstep(DRY_START-70.,DRY_START,contact.x))
	if contact.y>0.:return minf(contact.y,DRY_FLOOR if w.section=="fork_one" and pump_open(w) else LOWER_FLOOR)
	return default_y

static func choice_at(w) -> String:
	if not is_fork(str(w.section)) or w.state!="playing" or not w.grounded():return ""
	var contact: Vector2=foot(w)
	if contact.x<EXIT_X:return ""
	if absf(contact.y-UPPER_FLOOR)<1.:return "canopy" if w.section=="fork_one" else "terrace"
	if w.section=="fork_one" and absf(contact.y-MIDDLE_FLOOR)<1.:return "causeway"
	var lower: float=floor_height(w,contact.x)
	if lower>0. and absf(contact.y-lower)<1.:
		if w.section=="fork_two":return "roots"
		if not pump_open(w) or contact.x>=DRY_EXIT_X:return "water"
	return ""

static func step(w) -> void:
	if str(w.section)=="fork_two" and float(w.bridge_timers.get(SERVICE_BRIDGE_X,1.))<=0. and SERVICE_SUPPORT not in w.platforms:
		# The collapsed planks expose the near-side support. Even a regular
		# jump can recover the upper route without a charged hero ability.
		w.platforms.append(SERVICE_SUPPORT)
	if str(w.section)=="fork_two" and w.grounded() and not w.bridge_timers.has(SERVICE_BRIDGE_X):
		var contact: Vector2=foot(w)
		var span: Rect2=SERVICE_WALKWAYS[1]
		if contact.x>=span.position.x and contact.x<=span.end.x and absf(contact.y-span.position.y)<.1:
			w.bridge_timers[SERVICE_BRIDGE_X]=SERVICE_BRIDGE_SECONDS;w.notice="arc_bridge_warning";w.notice_time=2.
	if blocked_entry(w) and not w.notice=="arc_crawl_hint":
		w.notice="arc_crawl_hint";w.notice_time=2.2
	var destination: String=choice_at(w)
	if destination.is_empty():return
	if not w.route.has(destination):w.route.append(destination)
	w.begin_travel(destination)

static func draw_floor(v) -> bool:
	if not is_fork(str(v.world.section)):return false
	var w=v.world
	var second: bool=str(w.section)=="fork_two"
	# The material surface is exactly the collision surface. The lower channel
	# is not a hole painted over flat ground or a hidden portal.
	var start_lower: float=lower_start(w)
	var right: float=maxf(float(w.length()),v.camera_x+v.scene_w)
	var drained: bool=not second and pump_open(w)
	var segments: Array=[Vector3(0.,right,0.)] if second and not hatch_open(w) else [Vector3(0.,start_lower,0.),Vector3(start_lower,DRY_START if drained else right,LOWER_FLOOR)]
	if drained:segments.append(Vector3(DRY_START,right,DRY_FLOOR))
	for segment in segments:
		var start: float=maxf(float(segment.x),v.camera_x)
		var end: float=minf(float(segment.y),v.camera_x+v.scene_w)
		if end<=start:continue
		var y: float=v.ground+segment.z
		var height: float=maxf(0.,minf(192.,v.scene_h-y))
		var kind:=4 if segment.z==0. else (3 if segment.z==DRY_FLOOR else 2)
		var colours: Array[Color]=v.terrain.palette(kind)
		v.draw_rect(Rect2(start-v.camera_x,y,end-start,maxf(0.,v.scene_h-y)),colours[6])
		var x:=start
		while x<end:
			var length: float=minf(minf(128.,end-x),2048.-fposmod(x,2048.))
			var source_x: float=fposmod(x,2048.)*.5
			v.draw_texture_rect_region(v.terrain.tile(kind,0),Rect2(x-v.camera_x,y,length,height),Rect2(source_x,0,length*.5,height*.5))
			x+=length
	if not second or hatch_open(w):
		var edge: Vector2=v.at(Vector2(start_lower,0))
		v.draw_rect(Rect2(edge,Vector2(8,LOWER_FLOOR)),Color("625140"))
		v.draw_rect(Rect2(edge+Vector2(1,0),Vector2(3,LOWER_FLOOR)),Color("b99565"))
	if not second:draw_wet_passage(v,DRY_START if drained else right)
	if drained:draw_dry_passage(v,right)
	if second:draw_hatch(v)
	elif PIER.end.x>=v.camera_x and PIER.position.x<=v.camera_x+v.scene_w:draw_pier(v)
	return true

static func draw_wet_passage(v,right: float) -> void:
	var start: float=maxf(DROP_X,v.camera_x)
	var end: float=minf(right,v.camera_x+v.scene_w)
	if end<=start:return
	var surface: Vector2=v.at(Vector2(start,LOWER_FLOOR-12.))
	v.draw_rect(Rect2(surface,Vector2(end-start,13)),Color("294b5988"))
	var animated: bool=v.host.motion_enabled and not v.host.options.reduced_motion
	var phase:=float(posmod(floori(v.world.time*12.),72)) if animated else 0.
	for i in range(floori((start-DROP_X)/72.)-1,ceili((end-DROP_X)/72.)+1):
		var x:=DROP_X+i*72.+phase
		var span_start:=maxf(start,x)
		var span_end:=minf(end,x+18.+posmod(i,3)*9.)
		if span_end<=span_start:continue
		var p: Vector2=v.at(Vector2(span_start,LOWER_FLOOR-9.+posmod(i,3)*2.))
		v.draw_rect(Rect2(p,Vector2(span_end-span_start,2)),Color("6fafb399"))
		v.draw_rect(Rect2(p+Vector2(0,4),Vector2((span_end-span_start)*.6,1)),Color("84bbad75"))

static func draw_dry_passage(v,right: float) -> void:
	var ledge: Vector2=v.at(Vector2(DRY_START,LOWER_FLOOR))
	var drop: float=DRY_FLOOR-LOWER_FLOOR
	v.draw_rect(Rect2(ledge-Vector2(7,0),Vector2(10,drop)),Color("322d31"))
	v.draw_rect(Rect2(ledge-Vector2(5,0),Vector2(3,drop)),Color("b47852"))
	for y in range(4,int(drop),12):
		v.draw_rect(Rect2(ledge+Vector2(-6,y),Vector2(6,2)),Color("dcaf72"))
	var start: float=maxf(DRY_START,v.camera_x)
	var end: float=minf(right,v.camera_x+v.scene_w)
	if end<=start:return
	var top: Vector2=v.at(Vector2(start,DRY_FLOOR-88.))
	v.draw_rect(Rect2(top,Vector2(end-start,88.)),Color("251e29a8"))
	for x in range(int(DRY_START)+28,int(end)+110,110):
		if float(x)<start-32.:continue
		var p: Vector2=v.at(Vector2(float(x),DRY_FLOOR))
		v.draw_rect(Rect2(p+Vector2(-14,-88),Vector2(9,84)),Color("343240"))
		v.draw_rect(Rect2(p+Vector2(-12,-86),Vector2(3,83)),Color("74616a"))
		v.draw_rect(Rect2(p+Vector2(-18,-85),Vector2(17,4)),Color("bc9068"))
		v.draw_rect(Rect2(p+Vector2(-14,-58),Vector2(7,10)),Color("e0b780"))
		v.draw_rect(Rect2(p+Vector2(-20,-5),Vector2(22,5)),Color("77655a"))

static func draw_pier(v) -> void:
	# Native timber pixels share the existing bridge/crate material. The entire
	# facade stays within PIER; its roof and underside are the collision edges.
	var origin: Vector2=v.at(PIER.position)
	var size: Vector2=PIER.size
	v.draw_rect(Rect2(origin,size),Color("302d30"))
	# Recessed, staggered siding. Every source pixel remains one world pixel;
	# the final board is cropped, never stretched to fit the building.
	for y in range(24,220,16):
		for x in range(8,392,32):
			var width: int=mini(32,392-x)
			var height: int=mini(13,220-y)
			var variant: int=posmod(x/32+y/16,3)
			CampaignTimberArt.piece(v,Rect2(48+variant*32,6,width,height),origin+Vector2(x,y))
		if y+13<220:v.draw_rect(Rect2(origin+Vector2(8,y+13),Vector2(384,2)),Color("433638"))
	# Mortised vertical beams, iron straps and small directional bolt glints.
	for x in [0,126,262,388]:
		for y in range(12,220,32):
			CampaignTimberArt.piece(v,Rect2(152,0,12,mini(32,220-y)),origin+Vector2(x,y))
		for y in [26,126,200]:
			v.draw_rect(Rect2(origin+Vector2(x+1,y),Vector2(10,8)),Color("343b3f"))
			v.draw_rect(Rect2(origin+Vector2(x+2,y),Vector2(7,1)),Color("74807c"))
			v.draw_rect(Rect2(origin+Vector2(x+3,y+3),Vector2(2,2)),Color("b4b69a"))
	# Two deep workshop windows, with stepped metal frames and six warm panes.
	# They are facade details inside the solid house, never extra entry points.
	for x in [29.,292.]:
		var p: Vector2=origin+Vector2(x,47.)
		v.draw_rect(Rect2(p+Vector2(2,5),Vector2(80,70)),Color("30282a"))
		var edge:=PackedVector2Array([Vector2(0,7),Vector2(7,0),Vector2(69,0),Vector2(76,7),Vector2(76,57),Vector2(69,64),Vector2(7,64),Vector2(0,57)])
		for i in edge.size():edge[i]+=p
		v.draw_polygon(edge,PackedColorArray([Color("4b5353")]))
		v.draw_line(p+Vector2(8,1),p+Vector2(68,1),Color("9ca38c"),1.)
		v.draw_line(p+Vector2(1,8),p+Vector2(1,55),Color("79847d"),1.)
		for row in 3:
			var pane: Color=[Color("e5b975"),Color("bd884f"),Color("8d5c3b")][row]
			v.draw_rect(Rect2(p+Vector2(8,8+row*16),Vector2(60,14)),pane)
			v.draw_rect(Rect2(p+Vector2(10,9+row*16),Vector2(20,1)),pane.lightened(.16))
		v.draw_rect(Rect2(p+Vector2(36,7),Vector2(4,50)),Color("49463f"))
		v.draw_rect(Rect2(p+Vector2(36,8),Vector2(1,48)),Color("b1a17e"))
		for dx in [8,62]:
			CampaignTimberArt.piece(v,Rect2(48,0,16,7),p+Vector2(dx,64))
	# A closed ventilation/pump bay breaks the siding rhythm without inventing
	# a door, pickup, ladder, or another traversable surface.
	var vent: Vector2=origin+Vector2(158,43)
	v.draw_rect(Rect2(vent,Vector2(84,58)),Color("32373b"))
	v.draw_rect(Rect2(vent+Vector2(2,2),Vector2(80,54)),Color("6a7370"))
	v.draw_rect(Rect2(vent+Vector2(6,6),Vector2(72,46)),Color("29343a"))
	for y in range(8,49,7):
		v.draw_rect(Rect2(vent+Vector2(8,y),Vector2(68,3)),Color("545f60"))
		v.draw_rect(Rect2(vent+Vector2(8,y),Vector2(68,1)),Color("858d7e"))
	for dx in [3,78]:
		for dy in [3,51]:v.draw_rect(Rect2(vent+Vector2(dx,dy),Vector2(2,2)),Color("b6b59c"))
	# Short braces and a weathered service conduit remain entirely in the wall.
	for x in [14.,274.]:
		CampaignTimberArt.piece(v,CampaignTimberArt.BRACE,origin+Vector2(x,155))
		CampaignTimberArt.piece(v,CampaignTimberArt.BRACE_RIGHT,origin+Vector2(x+64,155))
	var pipe: Vector2=origin+Vector2(200,116)
	v.draw_rect(Rect2(pipe+Vector2(-4,0),Vector2(8,88)),Color("373c3d"))
	v.draw_rect(Rect2(pipe+Vector2(-2,0),Vector2(4,88)),Color("8c7660"))
	v.draw_rect(Rect2(pipe+Vector2(-2,1),Vector2(1,86)),Color("b2a080"))
	for y in [8,70]:
		v.draw_rect(Rect2(pipe+Vector2(-6,y),Vector2(12,4)),Color("5a6260"))
		v.draw_rect(Rect2(pipe+Vector2(-5,y),Vector2(9,1)),Color("9c9d86"))
	# A flat, continuous roof cap is the actual -195 walk surface. No raised
	# roof ornaments imply a platform that collision does not provide.
	for x in range(0,400,32):
		CampaignTimberArt.piece(v,Rect2(48+posmod(x/32,3)*32,0,mini(32,400-x),12),origin+Vector2(x,0))
		CampaignTimberArt.piece(v,Rect2(48+posmod(x/32+1,3)*32,6,mini(32,400-x),10),origin+Vector2(x,220))
	v.draw_rect(Rect2(origin+Vector2(0,229),Vector2(400,1)),Color("242e31"))
	# The entire 55px crawl opening stays visibly empty. Existing bridge posts
	# are background supports; this layer adds no posts or hanging obstacles.
	var passage: Vector2=v.at(Vector2(PIER.position.x,CRAWL_CEILING))
	v.draw_rect(Rect2(passage,Vector2(size.x,LOWER_FLOOR-CRAWL_CEILING)),Color("101d23",.65))
	# Small wall-mounted bulkhead lights end above the exact underside edge.
	for x in [20.,364.]:
		var lamp: Vector2=origin+Vector2(x,199)
		v.draw_rect(Rect2(lamp,Vector2(16,21)),Color("343a3b"))
		v.draw_rect(Rect2(lamp+Vector2(2,2),Vector2(12,17)),Color("94704a"))
		v.draw_rect(Rect2(lamp+Vector2(4,4),Vector2(8,12)),Color("f3c778"))
		v.draw_rect(Rect2(lamp+Vector2(5,4),Vector2(3,10)),Color("ffe7a8"))
		v.draw_rect(Rect2(lamp+Vector2(2,9),Vector2(12,2)),Color("635343"))
	# Reflected light and water sit on the route floor, with no flat glow panel.
	var mouth: Vector2=v.at(Vector2(PIER.position.x-60.,LOWER_FLOOR-8.))
	for i in 3:v.draw_rect(Rect2(mouth+Vector2(i*22.,-i*3.),Vector2(16,2)),Color("8fd3e8",.75))
	var glow: Vector2=v.at(Vector2(PIER.end.x-54.,LOWER_FLOOR-4.))
	for i in 3:v.draw_rect(Rect2(glow+Vector2(i*14.,-i*3.),Vector2(22-i*3,2)),Color("d8b46c",.48-i*.08))

static func draw_hatch(v) -> void:
	var w=v.world
	CampaignLockArt.root_hatch(v,v.at(Vector2(HATCH_X,0.)),YARD_END_X-HATCH_X,-UPPER_FLOOR-40.,hatch_open(w))

static func lantern_positions(w) -> Array[Vector2]:
	var positions: Array[Vector2]=[Vector2(1060.,UPPER_FLOOR),Vector2(1530.,UPPER_FLOOR)]
	var x: float=SERVICE_SUPPORT.get_center().x if w.section=="fork_two" else 550.
	# The same approach lantern sits on the service span and its exposed
	# replacement. A disabled span cannot support scenery.
	for deck in w.platforms:
		if deck.position.x<=x and x<=deck.end.x and not w.disabled_platforms.has(deck.position.x):
			positions.push_front(Vector2(x,deck.position.y))
			break
	var lower_y:=floor_height(w,1530.)
	if lower_y>0.:positions.append(Vector2(1530.,lower_y))
	if w.section=="fork_one":positions.append(Vector2(1568.,MIDDLE_FLOOR))
	return positions

static func exit_flag_positions(w) -> Array[Vector2]:
	var positions: Array[Vector2]=[Vector2(EXIT_X,UPPER_FLOOR)]
	var lower_x:=DRY_EXIT_X if w.section=="fork_one" and pump_open(w) else EXIT_X
	var lower_y:=floor_height(w,lower_x)
	if lower_y>0.:positions.append(Vector2(lower_x,lower_y))
	if w.section=="fork_one":positions.append(Vector2(EXIT_X,MIDDLE_FLOOR))
	return positions

static func draw_platform(v,deck: Rect2) -> bool:
	if is_shelter(str(v.world.section),deck):
		CampaignTimberArt.walkway(v,deck)
		var cap: Vector2=v.at(deck.position)
		v.draw_rect(Rect2(cap,Vector2(deck.size.x,5.)),Color("535057"))
		v.draw_rect(Rect2(cap+Vector2(0,1),Vector2(deck.size.x,1.)),Color("ac9874"))
		for x in range(7,int(deck.size.x)-6,20):
			v.draw_rect(Rect2(cap+Vector2(x,2),Vector2(8,2)),Color("b88d58"))
			v.draw_rect(Rect2(cap+Vector2(x+3,15),Vector2(2,3)),Color("dfb977"))
		return true
	if v.world.section!="fork_one" or (deck not in MIDDLE_WALKWAYS and deck!=DRY_CACHE_DECK):return false
	var surface: Vector2=v.at(deck.position)
	var width: float=deck.size.x
	var slab: float=deck.size.y
	v.draw_rect(Rect2(surface,deck.size),Color("33444b"))
	v.draw_rect(Rect2(surface+Vector2(0,1),Vector2(width,3.)),Color("a6a384"))
	for x in range(0,int(width),27):
		var span: float=minf(27.,width-x)
		var p: Vector2=surface+Vector2(x,4)
		v.draw_rect(Rect2(p,Vector2(span-1.,slab-6.)),Color("62696b") if x%2==0 else Color("515f61"))
		v.draw_rect(Rect2(p+Vector2(1,1),Vector2(maxf(1.,span-5.),1.)),Color("8b9290"))
		if span>16.:v.draw_rect(Rect2(p+Vector2(9,5),Vector2(6,2)),Color("768180"))
	for dx in [12.,width-23.]:
		var base: float=floor_height(v.world,deck.position.x+dx)
		var height: float=base-deck.position.y-slab
		if height<=0.:continue
		var post: Vector2=surface+Vector2(dx,slab)
		v.draw_rect(Rect2(post,Vector2(11.,height)),Color("383e45"))
		v.draw_rect(Rect2(post+Vector2(2,0),Vector2(3.,height)),Color("6c7473"))
		v.draw_rect(Rect2(post+Vector2(-4,height-5.),Vector2(19,5)),Color("737974"))
	return true

