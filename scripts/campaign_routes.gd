class_name CampaignRoutes
extends RefCounted

## Physical junctions: no choice state or dialog owns route selection.
## Upper wooden walkways and a lower channel share the actual floor queries.
const FORKS := ["fork_one","fork_two"]
const DROP_X := 650.
const LOWER_FLOOR := 90.
const UPPER_FLOOR := -195.
const EXIT_X := 1480.
const WALKWAYS := [Rect2(280.,-65.,240.,20.),Rect2(510.,-130.,260.,20.),Rect2(740.,UPPER_FLOOR,1040.,22.)]

static func is_fork(section: String) -> bool:
	return section in FORKS

static func floor_height(x: float) -> float:
	return LOWER_FLOOR if x>=DROP_X else 0.

static func populate(w) -> void:
	# Clear the procedural corridor generated by older checkpoints. Everything
	# below is real geometry/loot; no invisible 'choose high/low' trigger at entry.
	w.enemies.clear();w.gates.clear();w.pits.clear();w.platforms.clear()
	w.pickups.clear();w.crates.clear();w.npcs.clear();w.objects.clear()
	w.zones.clear();w.rooms.clear();w.hazards.clear();w.encounters.clear()
	for surface in WALKWAYS:w.platforms.append(surface)
	for position in [Vector2(1230.,UPPER_FLOOR),Vector2(1230.,LOWER_FLOOR)]:
		var kind: String="seed" if w.section=="fork_one" else ("mirror" if position.y==UPPER_FLOOR else "conductor")
		w.spawn_enemy(kind,position.x,position.y,w.enemies.size())
	var positions := [Vector2(330.,-100.),Vector2(450.,-100.),Vector2(560.,-165.),Vector2(680.,-165.),Vector2(820.,-230.),Vector2(1000.,-230.),Vector2(1180.,-230.),Vector2(1380.,-230.),Vector2(820.,55.),Vector2(1000.,55.),Vector2(1180.,55.),Vector2(1380.,55.)]
	for i in positions.size():
		var id: String=w.section+":route-fruit:"+str(i)
		if not w.taken.has(id):w.pickups.append({"id":id,"x":positions[i].x,"y":positions[i].y,"kind":"fruit_"+str(i%8)})

static func foot(w) -> Vector2:
	var offset:=0.
	if bool(w.mount.ridden):offset=42.-(24. if float(w.mount.get("dive",0.))>0. else 0.)
	return Vector2(w.player)+Vector2(0,offset)

static func clamp_horizontal(w,from_x: float,to_x: float) -> float:
	# The visible ninety-pixel ledge is solid from below. Walking left into
	# it cannot use the generic landing snap to teleport onto its upper floor.
	if is_fork(str(w.section)) and from_x>=DROP_X and to_x<DROP_X and foot(w).y>1.:return DROP_X
	return to_x

static func camera_y(w,default_y: float) -> float:
	# Follow the real lower floor upward on screen so portrait controls cannot
	# cover the hero. Above the entry floor, keep normal jump camera behavior.
	if is_fork(str(w.section)) and foot(w).y>0.:
		return clampf(foot(w).y,0.,LOWER_FLOOR)
	return default_y

static func choice_at(w) -> String:
	if not is_fork(str(w.section)) or w.state!="playing" or not w.grounded():return ""
	var contact: Vector2=foot(w)
	if contact.x<EXIT_X:return ""
	if absf(contact.y-UPPER_FLOOR)<1.:return "canopy" if w.section=="fork_one" else "terrace"
	if absf(contact.y-LOWER_FLOOR)<1.:return "water" if w.section=="fork_one" else "roots"
	return ""

static func step(w) -> void:
	var destination: String=choice_at(w)
	if destination.is_empty():return
	if not w.route.has(destination):w.route.append(destination)
	w.travel_target=destination;w.state="travel";w.stop_inputs()

static func draw_floor(v) -> bool:
	if not is_fork(str(v.world.section)):return false
	# The material surface is exactly the collision surface. The lower channel
	# is not a hole painted over the old flat ground or a hidden portal.
	for segment in [Vector3(0.,DROP_X,0.),Vector3(DROP_X,maxf(float(v.world.length()),v.camera_x+v.scene_w),LOWER_FLOOR)]:
		var start: float=maxf(float(segment.x),v.camera_x)
		var end: float=minf(float(segment.y),v.camera_x+v.scene_w)
		if end<=start:continue
		var y: float=v.ground+segment.z
		var height: float=maxf(0.,minf(192.,v.scene_h-y))
		var kind:=4 if segment.z==0. else 2
		var colours: Array[Color]=v.terrain.palette(kind)
		v.draw_rect(Rect2(start-v.camera_x,y,end-start,maxf(0.,v.scene_h-y)),colours[6])
		var x:=start
		while x<end:
			var length: float=minf(minf(128.,end-x),2048.-fposmod(x,2048.))
			var source_x: float=fposmod(x,2048.)*.5
			v.draw_texture_rect_region(v.terrain.tile(kind,0),Rect2(x-v.camera_x,y,length,height),Rect2(source_x,0,length*.5,height*.5))
			x+=length
	var edge: Vector2=v.at(Vector2(DROP_X,0))
	v.draw_rect(Rect2(edge,Vector2(8,LOWER_FLOOR)),Color("625140"))
	v.draw_rect(Rect2(edge+Vector2(1,0),Vector2(3,LOWER_FLOOR)),Color("b99565"))
	return true

static func draw_landmarks(v) -> void:
	if not is_fork(str(v.world.section)):return
	# Existing lantern and foliage art supplies destination atmosphere. Arrows
	# are physical painted signs, never an interactive route-choice panel.
	for p in [Vector2(550.,-130.),Vector2(1060.,UPPER_FLOOR),Vector2(1530.,UPPER_FLOOR),Vector2(1530.,LOWER_FLOOR)]:
		v.draw_pose(v.catalogue.pose("environment",2,3),p)
	for floor_y in [UPPER_FLOOR,LOWER_FLOOR]:
		v.draw_flag(Vector2(EXIT_X,floor_y),.84)
	for position in [Vector2(220.,-56.),Vector2(880.,LOWER_FLOOR-56.)]:
		var p: Vector2=v.at(position)
		var upper: bool=position.x<300.
		v.draw_rect(Rect2(p,Vector2(44,30)),Color("514238"))
		v.draw_rect(Rect2(p+Vector2(2,2),Vector2(40,26)),Color("bd9b67"))
		var s:=Vector2(1.,-1. if upper else 1.)
		var center: Vector2=p+Vector2(22,15)
		v.draw_rect(Rect2(p+Vector2(20,8),Vector2(5,14)),Color("eee0ad"))
		var arrow:=PackedVector2Array([center+Vector2(-10,0)*s,center+Vector2(0,10)*s,center+Vector2(10,0)*s])
		v.draw_polyline(arrow,Color("eee0ad"),4.)
		v.draw_rect(Rect2(p+Vector2(19,30),Vector2(6,26)),Color("69523d"))
