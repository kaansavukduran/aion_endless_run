## Regenerates assets/SECTION-SHEETS.json: the source sheets each Mission 1
## section draws while its length is swept on screen. Run under a renderer:
## xvfb-run godot --audio-driver Dummy --script tests/gen_section_sheets.gd
extends SceneTree
func _initialize():call_deferred("run")
func run():
	root.size=Vector2i(1280,720)
	var game=AionCampaignGame.new();game.selected_hero="aion";root.add_child(game);await process_frame
	game.presentation_stage="";game.menu_kind="";game.fade=-1.;game.build_ui()
	var manifest:={}
	# World sheets are hero-independent; hero sheets stay resident because the
	# hero is drawn every frame, so they are excluded from the warm-up list.
	for hero in ["aion"]:
		for section in AionCampaignWorld.STAGES:
			RunnerSourcePixels.known_sections={"_generator":[]}
			game.world.load_section(section)
			# Record only what the sweep draws, never what warm-up decoded.
			RunnerSourcePixels.section_paths.erase(section)
			var steps:=maxi(4,int(game.world.length()/500.))
			for i in steps+1:
				game.world.player.x=clampf(game.world.length()*i/steps,140.,game.world.length()-140.);game.world.state="playing";game.world.invulnerable=99.
				for f in 2:await process_frame
			var paths: Array=RunnerSourcePixels.section_paths.get(section,{}).keys().filter(func(p):return not RunnerSourcePixels.hero_sheet(p))
			paths.sort();manifest[section]=paths
	var file:=FileAccess.open("res://assets/SECTION-SHEETS.json",FileAccess.WRITE)
	file.store_string(JSON.stringify({"note":"Generated by tests/gen_section_sheets.gd; the hero-independent sheets each section draws. Used only to pre-decode behind the travel fade.","sections":manifest},"\t",true)+"\n")
	file.close()
	for section in manifest:print("SECTION ",section,"=",manifest[section].size())
	quit()
